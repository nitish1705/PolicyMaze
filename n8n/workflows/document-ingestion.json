{
  "name": "Policy Maze — Citizen Document Upload",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "citizen-document-uploaded",
        "responseMode": "onReceived"
      },
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "position": [250, 300]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.fields_extracted }}",
              "operation": "larger",
              "value2": 0
            }
          ]
        }
      },
      "name": "Fields Extracted?",
      "type": "n8n-nodes-base.if",
      "position": [450, 300]
    },
    {
      "parameters": {
        "message": "=Document uploaded: {{ $json.doc_type }}\nFields extracted: {{ $json.fields_extracted }}\nDocument ID: {{ $json.document_id }}"
      },
      "name": "Notify Success",
      "type": "n8n-nodes-base.noOp",
      "position": [650, 200]
    },
    {
      "parameters": {
        "message": "=Warning: {{ $json.doc_type }} uploaded but no fields could be extracted. OCR or format may need manual review."
      },
      "name": "Alert Extraction Failed",
      "type": "n8n-nodes-base.noOp",
      "position": [650, 400]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [{ "node": "Fields Extracted?", "type": "main", "index": 0 }]
      ]
    },
    "Fields Extracted?": {
      "main": [
        [{ "node": "Notify Success", "type": "main", "index": 0 }],
        [{ "node": "Alert Extraction Failed", "type": "main", "index": 0 }]
      ]
    }
  }
}
